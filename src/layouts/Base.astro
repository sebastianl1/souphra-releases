---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Ψ Souphra — Música sin interrupciones', description = 'Radio colombiana en vivo, biblioteca, crossfade y letras. Gratis, sin anuncios, siempre actualizada.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sebastianl1.github.io/souphra-releases/" />
    <meta name="theme-color" content="#7a0a0a" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/souphra-releases/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Unbounded:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
