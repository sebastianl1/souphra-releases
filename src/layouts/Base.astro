---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Souphra — Música sin interrupciones', description = 'Radio colombiana en vivo, biblioteca, crossfade y letras. App privada, gratuita y siempre actualizada.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sebastianl1.github.io/souphra-releases/" />
    <meta name="theme-color" content="#FF5A5A" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/souphra-releases/logo.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
