---
import Base from '../layouts/Base.astro';
import { carteras, BUYMEACOFFEE_URL, SPONSORS_URL } from '../data/donations';

const RELEASES_URL = 'https://github.com/sebastianl1/souphra-releases/releases/latest';
const volver = import.meta.env.BASE_URL;
---

<Base
  title="Dona a Souphra — Buy Me a Coffee, GitHub Sponsors y criptomonedas"
  description="Apoya el desarrollo de Souphra: invítanos un café, patrocina el proyecto en GitHub o dona con criptomonedas. Cualquier aporte ayuda a mantener la app gratuita."
  path="/donar/"
>
  <nav>
    <div class="container inner">
      <a href={volver} class="logo">
        <img src="/souphra-releases/logo.svg" alt="" width="36" height="36" />
        <span>souphra</span>
      </a>
      <div class="nav-actions">
        <a href={volver} class="btn btn-outline btn-sm">← Inicio</a>
        <a href={RELEASES_URL} class="btn btn-primary btn-sm hide-sm-text">Descargar app</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="section-pad" style="position:relative; overflow:hidden">
      <span class="psi-watermark" style="right:-40px; top:-70px" aria-hidden="true">Ψ</span>
      <div class="grid-pattern" style="position:absolute; inset:0; opacity:.5; pointer-events:none" aria-hidden="true"></div>
      <div class="container" style="position:relative">
        <div class="reveal" style="text-align:center; max-width:660px; margin:0 auto">
          <span class="badge"><span class="badge-dot pulse"></span> Apoya el proyecto</span>
          <h1 style="margin:18px 0 0; font-size:clamp(34px,5vw,52px); line-height:1.05">
            Invítanos a un café <span class="text-gradient">☕</span>
          </h1>
          <p style="margin:18px 0 0; color:var(--muted); line-height:1.65; font-size:16px">
            Souphra es y siempre será gratuita. Si te gusta la app y quieres colaborar con el
            mantenimiento, las actualizaciones y las emisoras nuevas, cualquier aporte ayuda muchísimo.
          </p>
        </div>

        <div class="donate-grid" style="margin-top:48px">
          <!-- Buy Me a Coffee -->
          <article class="card donate-card donate-featured reveal reveal-d1">
            <div class="donate-icon" style="background:linear-gradient(180deg,#ffdd00,#f5a623); color:#3d0206" aria-hidden="true">☕</div>
            <h2 style="margin:18px 0 0; font-size:20px">Buy Me a Coffee</h2>
            <p style="margin:8px 0 0; font-size:14px; color:var(--muted); line-height:1.65">
              La forma más rápida de apoyar el proyecto, con tarjeta o desde tu app favorita.
              Recomendada si es tu primera donación.
            </p>
            <a
              href={BUYMEACOFFEE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
              style="justify-content:center; margin-top:22px"
            >
              Invitar un café
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </a>
          </article>

          <!-- GitHub Sponsors -->
          <article class="card donate-card reveal reveal-d2">
            <div class="donate-icon" style="background:linear-gradient(180deg,#f78166,#c9515c); color:#1a0406" aria-hidden="true">♥</div>
            <h2 style="margin:18px 0 0; font-size:20px">GitHub Sponsors</h2>
            <p style="margin:8px 0 0; font-size:14px; color:var(--muted); line-height:1.65">
              Apoya con un patrocinio directo desde GitHub, ideal si ya tienes una cuenta.
              Puedes hacer aportes únicos o mensuales.
            </p>
            <a
              href={SPONSORS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
              style="justify-content:center; margin-top:22px"
            >
              Patrocinar en GitHub
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
            </a>
          </article>

          <!-- Criptomonedas -->
          <article class="card donate-card reveal reveal-d3">
            <div class="donate-icon" style="background:linear-gradient(180deg,#ff8a91,#b3121f); color:#fff" aria-hidden="true">₿</div>
            <h2 style="margin:18px 0 0; font-size:20px">Criptomonedas</h2>
            <p style="margin:8px 0 0; font-size:14px; color:var(--muted); line-height:1.65">
              Si prefieres cripto, copia la dirección de la red que uses. Verifica siempre la red
              antes de enviar.
            </p>
            <div style="margin-top:22px; display:flex; flex-direction:column; gap:10px">
              {Object.entries(carteras).map(([red, direccion]) => (
                <div class="wallet-row">
                  <span class="wallet-net">{red}</span>
                  {direccion ? (
                    <button type="button" class="copy-btn" data-copy={direccion} aria-label={`Copiar dirección ${red}`}>
                      Copiar
                    </button>
                  ) : (
                    <span class="wallet-soon">Muy pronto</span>
                  )}
                </div>
              ))}
            </div>
          </article>
        </div>

        <div class="reveal" style="margin:40px auto 0; max-width:660px">
          <div class="card" style="display:flex; gap:16px; align-items:flex-start">
            <span aria-hidden="true" style="font-size:22px">💚</span>
            <p style="margin:0; font-size:14px; color:var(--muted); line-height:1.65">
              <strong style="color:#fff">La app nunca pedirá dinero dentro de la aplicación.</strong>
              Las donaciones son 100 % voluntarias y se usan para mantener Souphra viva:
              servidores, dominios, licencias y horas de desarrollo.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer style="border-top:1px solid var(--line)">
    <div class="container" style="padding:36px 24px; display:flex; flex-wrap:wrap; gap:16px; align-items:center; justify-content:space-between; font-size:14px; color:var(--text-dim)">
      <span>© 2026 <span style="font-family:'Poppins'; font-weight:800; color:#fff">Ψ souphra</span> — Hecho por Sebastian L.</span>
      <div style="display:flex; gap:20px">
        <a href="https://sebastianl1.github.io/Portafolio/" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:none">♪ Portafolio</a>
        <a href={volver} style="color:inherit; text-decoration:none">Inicio</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var texto = btn.getAttribute('data-copy') || '';
        var restaurar = function () {
          btn.textContent = 'Copiado ✓';
          btn.classList.add('copied');
          setTimeout(function () {
            btn.textContent = 'Copiar';
            btn.classList.remove('copied');
          }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(texto).then(restaurar);
        } else {
          var tmp = document.createElement('textarea');
          tmp.value = texto;
          document.body.appendChild(tmp);
          tmp.select();
          document.execCommand('copy');
          document.body.removeChild(tmp);
          restaurar();
        }
      });
    });
  </script>
</Base>
