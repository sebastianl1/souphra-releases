---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- NAV -->
  <nav>
    <div class="container inner">
      <a href="#" class="logo">
        <span class="logo-mark">S</span>
        <span>souphra</span>
        <span class="badge" style="margin-left:4px"><span class="badge-dot"></span> Privado • Gratis</span>
      </a>
      <div class="nav-links">
        <a href="#features">Funciones</a>
        <a href="#radio">Radio</a>
        <a href="#como">Cómo instalar</a>
        <a href="#legal">Legal</a>
      </div>
      <a id="navDownload" href="https://github.com/sebastianl1/souphra-releases/releases/latest" class="btn btn-primary btn-sm">Descargar APK</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="section-pad" style="position:relative; overflow:hidden">
    <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(255,90,90,.14), transparent); pointer-events:none"></div>
    <div style="position:absolute; top:-80px; right:-80px; width:560px; height:560px; border-radius:50%; background:rgba(255,90,90,.18); filter:blur(90px); pointer-events:none"></div>
    <div class="grid-pattern" style="position:absolute; inset:0; opacity:.04; pointer-events:none"></div>
    <div class="container" style="position:relative; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center">
      <div>
        <span class="badge"><span class="badge-dot"></span> Hecho en Colombia • #FF5A5A sobre #121212</span>
        <h1 style="margin:24px 0 0; font-size:52px; line-height:.95; letter-spacing:-.02em">
          Música sin<br/><span style="color:var(--brand)">interrupciones.</span>
        </h1>
        <p style="margin:20px 0 0; font-size:17px; color:rgba(255,255,255,.65); line-height:1.6; max-width:52ch">
          Radio colombiana en vivo, biblioteca, crossfade y letras sincronizadas — en una app <strong style="color:#fff">privada, rápida y sin anuncios</strong>, siempre actualizada automáticamente.
        </p>
        <div style="margin-top:32px; display:flex; flex-wrap:wrap; gap:12px">
          <a id="heroDownload" href="https://github.com/sebastianl1/souphra-releases/releases/latest" class="btn btn-primary glow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V3M12 15l-4-4M12 15l4-4M2 17l.06 1.2a1.5 1.5 0 0 0 1.44 1.4H20a1.5 1.5 0 0 0 1.5-1.5V17"/></svg>
            Descargar APK
          </a>
          <a href="#features" class="btn btn-ghost">Explorar funciones</a>
        </div>
        <div style="margin-top:24px; display:flex; flex-wrap:wrap; gap:10px">
          <span class="badge"><span class="badge-dot" style="animation:pulse 1.6s infinite"></span> Actualización automática cada 24 h</span>
          <span class="badge" id="latestTag" style="color:rgba(255,255,255,.5)">cargando versión…</span>
        </div>
        <style>
          @keyframes pulse { 50% { opacity:.3 } }
        </style>
        <p style="margin-top:12px; font-size:12px; color:rgba(255,255,255,.35); max-width:56ch">
          Si ves “Actualización disponible” a pantalla completa, toca <strong style="color:rgba(255,255,255,.6)">Descargar</strong> — se descarga directo; si falla, abre el navegador en la página del release.
        </p>
      </div>
      <div style="justify-self:center; width:100%; max-width:340px">
        <div class="glow" style="border-radius:40px; padding:12px; background:linear-gradient(180deg,#18181b,#000); border:1px solid var(--line)">
          <div style="background:#000; border-radius:32px; overflow:hidden; border:1px solid var(--line)">
            <div style="height:24px; background:#18181b; display:flex; align-items:center; justify-content:center"><span style="width:80px; height:6px; background:rgba(255,255,255,.1); border-radius:99px"></span></div>
            <div style="aspect-ratio:9/19; background:linear-gradient(135deg,#18181b,#0a0a0a); display:grid; place-items:center; padding:32px; text-align:center">
              <div>
                <div style="width:80px; height:80px; margin:0 auto; border-radius:22px; background:var(--brand); display:grid; place-items:center; font-size:32px; font-weight:800">S</div>
                <p style="margin:16px 0 0; font-family:Poppins; font-weight:700">souphra</p>
                <p style="margin:4px 0 0; font-size:12px; color:rgba(255,255,255,.4)">Radio • Biblioteca • Letras</p>
                <div style="margin-top:24px; display:flex; gap:8px; justify-content:center">
                  <span style="width:8px; height:8px; border-radius:50%; background:var(--brand); animation:pulse 1.4s infinite"></span>
                  <span style="width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,.2)"></span>
                  <span style="width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,.2)"></span>
                </div>
              </div>
            </div>
            <div style="height:56px; background:#000; border-top:1px solid var(--line); display:flex; align-items:center; justify-content:space-around; padding:0 8px">
              <span style="width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.1); display:grid; place-items:center; font-size:12px">⌂</span>
              <span style="width:40px; height:40px; border-radius:50%; background:var(--brand); display:grid; place-items:center; font-size:12px">♫</span>
              <span style="width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.1); display:grid; place-items:center; font-size:12px">◎</span>
              <span style="width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.1); display:grid; place-items:center; font-size:12px">♡</span>
              <span style="width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.1); display:grid; place-items:center; font-size:12px">≡</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section style="border-block:1px solid var(--line); background:rgba(26,26,26,.5)">
    <div class="container" style="padding:16px 24px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:rgba(255,255,255,.4)">
      <span>Sin anuncios</span><span style="color:rgba(255,255,255,.1)">•</span><span>Sin cobros</span><span style="color:rgba(255,255,255,.1)">•</span><span>Sin rastreo</span><span style="color:rgba(255,255,255,.1)">•</span><span>Siempre al día</span><span style="color:rgba(255,255,255,.1)">•</span><span>Hecho para amigos</span>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="container section-pad">
    <div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:24px">
      <h2 class="section-title">Todo lo que importa, nada que sobra</h2>
      <span style="font-size:14px; color:rgba(255,255,255,.4)">Diseño oscuro • #121212 + #FF5A5A</span>
    </div>
    <div style="margin-top:32px; display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px">
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center;font-weight:700">◉</div><h3 style="margin:16px 0 0">Radio continua</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">27 emisoras colombianas verificadas con reconexión transparente — sin cortes ni loops.</p></div>
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center">♬</div><h3 style="margin:16px 0 0">Reproducción pro</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">Crossfade, cola infinita, letras sincronizadas, SponsorBlock y normalización.</p></div>
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center">⬢</div><h3 style="margin:16px 0 0">Interfaz cuidada</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">Barra negra con partículas, transiciones corregidas y ajustes por categorías.</p></div>
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center">⬇</div><h3 style="margin:16px 0 0">Actualización forzada</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">Comprueba cada 24 h y te obliga a actualizar — descarga directa o navegador.</p></div>
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center">◎</div><h3 style="margin:16px 0 0">Navegación sólida</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">Sin pantallas a medias, con debounce y haze optimizado.</p></div>
      <div class="card"><div style="width:40px;height:40px;border-radius:12px;background:rgba(255,90,90,.15);color:var(--brand);display:grid;place-items:center">♡</div><h3 style="margin:16px 0 0">Privada y gratuita</h3><p style="margin:8px 0 0;font-size:14px;color:rgba(255,255,255,.6);line-height:1.6">Para compartir entre amigos. Sin cobros, sin suscripciones, sin anuncios.</p></div>
    </div>
  </section>

  <!-- RADIO -->
  <section id="radio" style="background:var(--surface); border-block:1px solid var(--line)">
    <div class="container section-pad" style="display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center">
      <div>
        <span class="badge" style="color:var(--brand); background:rgba(255,90,90,.12)">En vivo • Colombia</span>
        <h2 style="margin-top:12px; font-size:26px">Radio de Colombia, sin interrupciones</h2>
        <p style="margin:12px 0 0; color:rgba(255,255,255,.6); line-height:1.6">Caracol, W Radio, Olímpica, Tropicana, La Mega, Radioacktiva y 20 más — verificadas y con reconexión transparente que evita repeticiones.</p>
        <ul style="margin-top:24px; display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:14px; color:rgba(255,255,255,.7)">
          <li>• Caracol Radio</li><li>• W Radio</li><li>• Olímpica Stereo</li><li>• Tropicana</li><li>• La Mega</li><li>• Blu Radio</li><li>• Radioacktiva</li><li>• +20 emisoras</li>
        </ul>
      </div>
      <div class="card" style="background:var(--ink)">
        <div style="display:flex; align-items:center; justify-content:space-between">
          <span style="font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:rgba(255,255,255,.4)">En vivo</span>
          <span style="display:inline-flex; align-items:center; gap:6px; font-size:12px; padding:6px 12px; border-radius:99px; background:var(--brand); color:#fff">LIVE <span style="width:7px;height:7px;border-radius:50%;background:#fff;animation:pulse 1.4s infinite"></span></span>
        </div>
        <div style="margin-top:16px; height:96px; background:linear-gradient(90deg, rgba(255,90,90,.2), rgba(255,90,90,.05)); border-radius:14px; border:1px solid rgba(255,255,255,.05); display:grid; place-items:center; color:rgba(255,255,255,.3); font-size:14px">Visualizador — en la app</div>
        <div style="margin-top:16px; display:flex; align-items:center; justify-content:space-between; font-size:14px"><span style="color:rgba(255,255,255,.6)">Ahora suena</span><span style="font-weight:500">Continúa sin cortes</span></div>
      </div>
    </div>
  </section>

  <!-- COMO + DESCARGA -->
  <section id="como" class="container section-pad">
    <div style="border-radius:26px; padding:1px; background:linear-gradient(135deg, var(--brand), var(--brand-dark))">
      <div style="border-radius:22px; background:var(--ink); padding:40px">
        <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:32px">
          <div>
            <h2 style="font-size:26px; margin:0">Descarga la última versión</h2>
            <p style="margin:8px 0 0; color:rgba(255,255,255,.6); max-width:52ch">La APK se publica en GitHub Releases. La app te avisa cada 24 h y te pide actualizar — descarga directa prioritaria, navegador como respaldo.</p>
            <div style="margin-top:16px; display:flex; flex-wrap:wrap; gap:8px; font-size:12px">
              <span class="badge" id="dlVersion">versión…</span>
              <span class="badge" id="dlDate" style="color:rgba(255,255,255,.5)">fecha…</span>
              <span class="badge" style="color:rgba(255,255,255,.5)">arm64-v8a • universal</span>
            </div>
          </div>
          <div style="display:flex; flex-direction:column; gap:12px; width:100%; max-width:260px">
            <a id="dlPrimary" href="https://github.com/sebastianl1/souphra-releases/releases/latest" class="btn btn-primary" style="justify-content:center">Descargar APK</a>
            <a href="https://github.com/sebastianl1/souphra-releases/releases" style="text-align:center; font-size:14px; color:rgba(255,255,255,.6); text-decoration:none">Ver todas las releases →</a>
          </div>
        </div>
      </div>
    </div>
    <div style="margin-top:32px; display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:20px; font-size:14px">
      <div class="card"><span style="width:32px;height:32px;border-radius:50%;background:#fff;color:var(--ink);display:grid;place-items:center;font-weight:700">1</span><h3 style="margin:16px 0 0">Descarga</h3><p style="margin:8px 0 0;color:rgba(255,255,255,.6)">Toca Descargar APK. Si el asset está disponible, baja directo; si no, abre la página del release.</p></div>
      <div class="card"><span style="width:32px;height:32px;border-radius:50%;background:#fff;color:var(--ink);display:grid;place-items:center;font-weight:700">2</span><h3 style="margin:16px 0 0">Permite instalación</h3><p style="margin:8px 0 0;color:rgba(255,255,255,.6)">Android → “Instalar apps desconocidas” para el navegador/administrador.</p></div>
      <div class="card"><span style="width:32px;height:32px;border-radius:50%;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:700">3</span><h3 style="margin:16px 0 0">Actualización forzada</h3><p style="margin:8px 0 0;color:rgba(255,255,255,.6)">Cuando haya versión nueva verás notificación y diálogo bloqueante hasta instalar.</p></div>
    </div>
  </section>

  <!-- LEGAL -->
  <section id="legal" style="background:var(--surface); border-block:1px solid var(--line)">
    <div class="container" style="padding:48px 24px">
      <h2 style="font-size:22px; margin:0">Legal — uso libre y gratuito</h2>
      <div style="margin-top:24px; display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:24px; font-size:14px; line-height:1.6">
        <div class="card" style="background:var(--ink)"><h3 style="margin:0; color:#fff">Gratis, sin cobros</h3><p style="margin:8px 0 0; color:rgba(255,255,255,.6)">Souphra es <strong style="color:#fff">totalmente gratuita</strong>. No se cobra por la app, ni por descargas, ni por funciones. No hay compras internas, suscripciones, ni anuncios. Puedes instalarla y compartir la APK libremente entre amigos.</p></div>
        <div class="card" style="background:var(--ink)"><h3 style="margin:0; color:#fff">Respeto a derechos</h3><p style="margin:8px 0 0; color:rgba(255,255,255,.6)">La app reproduce contenido disponible públicamente (YouTube Music y streams de radio). No aloja música ni elude DRM. El uso debe respetar los términos de las fuentes originales.</p></div>
        <div class="card" style="background:var(--ink)"><h3 style="margin:0; color:#fff">Privacidad y transparencia</h3><p style="margin:8px 0 0; color:rgba(255,255,255,.6)">No se recopilan datos personales más allá de lo necesario para reproducir y notificar actualizaciones. No se vende información.</p></div>
      </div>
      <p style="margin-top:24px; font-size:12px; color:rgba(255,255,255,.3)">Si eres titular de derechos y consideras que algún stream debe retirarse, abre un Issue en <a href="https://github.com/sebastianl1/souphra-releases/issues" style="text-decoration:underline; color:inherit">souphra-releases</a>.</p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="border-top:1px solid var(--line)">
    <div class="container" style="padding:32px 24px; display:flex; flex-direction:column; gap:16px; align-items:center; justify-content:space-between; text-align:center; font-size:14px; color:rgba(255,255,255,.4)">
      <span>© 2026 Souphra — Hecho con ♥ en Colombia • <span style="color:var(--brand)">#FF5A5A</span> sobre <span style="color:#fff">#121212</span></span>
      <div style="display:flex; gap:20px">
        <a href="https://github.com/sebastianl1/souphra-releases/releases" style="color:inherit; text-decoration:none">Releases</a>
        <a href="https://github.com/sebastianl1/souphra-releases" style="color:inherit; text-decoration:none">Repositorio</a>
        <a href="#legal" style="color:inherit; text-decoration:none">Legal</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    async function loadRelease() {
      try {
        const r = await fetch('https://api.github.com/repos/sebastianl1/souphra-releases/releases/latest', { headers: { 'Accept': 'application/vnd.github+json' } });
        if (!r.ok) throw new Error(r.status);
        const j = await r.json();
        const tag = j.tag_name || j.name || '—';
        const date = j.published_at ? new Date(j.published_at).toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
        const apk = (j.assets || []).find(a => a.name && a.name.endsWith('.apk')) || j.assets?.[0];
        const el = id => document.getElementById(id);
        el('latestTag').textContent = tag;
        el('dlVersion').textContent = tag;
        el('dlDate').textContent = date;
        const url = apk ? apk.browser_download_url : j.html_url;
        if (url) {
          el('dlPrimary').href = url;
          el('heroDownload').href = url;
          el('navDownload').href = url;
        }
      } catch (e) {
        const el = id => document.getElementById(id);
        el('latestTag').textContent = 'sin releases aún';
        el('dlVersion').textContent = 'próximamente';
        el('dlDate').textContent = '';
      }
    }
    loadRelease();
  </script>
</Base>
